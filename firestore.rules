rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner() {
      return request.auth != null
        && request.auth.token.email == 'christophershelley257@gmail.com'
        && request.auth.token.email_verified == true;
    }

    match /publicQr/{tagId} {
      allow read: if true;
      allow create, update, delete: if isOwner();
    }

    match /users/{userId} {
      allow read, create, update, delete: if isOwner();
    }

    match /transactions/{document=**} {
      allow read, write: if isOwner();
    }

    match /receipts/{document=**} {
      allow read, write: if isOwner();
    }

    match /assets/{document=**} {
      allow read, write: if isOwner();
    }

    match /qrTags/{document=**} {
      allow read, write: if isOwner();
    }

    match /books/{document=**} {
      allow read, write: if isOwner();
    }

    match /locations/{document=**} {
      allow read, write: if isOwner();
    }

    match /loans/{document=**} {
      allow read, write: if isOwner();
    }

    match /activity/{document=**} {
      allow read, write: if isOwner();
    }

    match /budgetCategories/{document=**} {
      allow read, write: if isOwner();
    }

    match /incomeSources/{document=**} {
      allow read, write: if isOwner();
    }

    match /recurringExpenses/{document=**} {
      allow read, write: if isOwner();
    }

    match /savingsGoals/{document=**} {
      allow read, write: if isOwner();
    }

    match /savingsContributions/{document=**} {
      allow read, write: if isOwner();
    }

    match /budgetSettings/{document=**} {
      allow read, write: if isOwner();
    }

    match /workHours/{document=**} {
      allow read, write: if isOwner();
    }

    match /finderReports/{reportId} {
      allow create: if request.resource.data.keys().hasOnly([
          'publicSlug',
          'labelCode',
          'targetType',
          'reporterName',
          'contactEmail',
          'contactPhone',
          'foundLocation',
          'message',
          'consentToContact',
          'status',
          'createdAt'
        ])
        && request.resource.data.keys().hasAll([
          'publicSlug',
          'labelCode',
          'targetType',
          'reporterName',
          'contactEmail',
          'contactPhone',
          'foundLocation',
          'message',
          'consentToContact',
          'status',
          'createdAt'
        ])
        && request.resource.data.publicSlug is string
        && request.resource.data.publicSlug.size() > 5
        && request.resource.data.publicSlug.size() <= 64
        && exists(/databases/$(database)/documents/publicQr/$(request.resource.data.publicSlug))
        && get(/databases/$(database)/documents/publicQr/$(request.resource.data.publicSlug)).data.status in ['active', 'lost']
        && get(/databases/$(database)/documents/publicQr/$(request.resource.data.publicSlug)).data.labelCode == request.resource.data.labelCode
        && get(/databases/$(database)/documents/publicQr/$(request.resource.data.publicSlug)).data.targetType == request.resource.data.targetType
        && request.resource.data.labelCode is string
        && request.resource.data.labelCode.size() <= 32
        && request.resource.data.targetType is string
        && request.resource.data.targetType.size() > 0
        && request.resource.data.targetType.size() <= 40
        && request.resource.data.reporterName is string
        && request.resource.data.reporterName.size() > 0
        && request.resource.data.reporterName.size() <= 100
        && request.resource.data.contactEmail is string
        && request.resource.data.contactEmail.size() <= 200
        && request.resource.data.contactPhone is string
        && request.resource.data.contactPhone.size() <= 60
        && (request.resource.data.contactEmail.size() > 0 || request.resource.data.contactPhone.size() > 0)
        && request.resource.data.foundLocation is string
        && request.resource.data.foundLocation.size() <= 300
        && request.resource.data.message is string
        && request.resource.data.message.size() > 0
        && request.resource.data.message.size() <= 2000
        && request.resource.data.consentToContact == true
        && request.resource.data.status == 'new'
        && request.resource.data.createdAt == request.time;

      allow read, update, delete: if isOwner();
    }

    match /meta/{document=**} {
      allow read, write: if isOwner();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner() {
      return request.auth != null
        && request.auth.token.email == 'christophershelley257@gmail.com'
        && request.auth.token.email_verified == true;
    }

    match /publicQr/{tagId} {
      allow read: if true;
      allow create, update, delete: if isOwner();
    }

    match /users/{userId} {
      allow read, create, update, delete: if isOwner();
    }

    match /transactions/{document=**} {
      allow read, write: if isOwner();
    }

    match /receipts/{document=**} {
      allow read, write: if isOwner();
    }

    match /assets/{document=**} {
      allow read, write: if isOwner();
    }

    match /qrTags/{document=**} {
      allow read, write: if isOwner();
    }

    match /books/{document=**} {
      allow read, write: if isOwner();
    }

    match /locations/{document=**} {
      allow read, write: if isOwner();
    }

    match /loans/{document=**} {
      allow read, write: if isOwner();
    }

    match /activity/{document=**} {
      allow read, write: if isOwner();
    }

    match /meta/{document=**} {
      allow read, write: if isOwner();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
